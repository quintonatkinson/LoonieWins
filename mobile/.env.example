# Expo mobile — copy to mobile/.env (never commit .env)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional AdGem / RevenueCat (public SDK keys only)
# EXPO_PUBLIC_ADGEM_APP_ID=your-adgem-app-id
# EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_xxx
