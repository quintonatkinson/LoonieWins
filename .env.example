VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: rss2json API key (get from rss2json.com) to fetch 50+ items per feed instead of 10
# VITE_RSS2JSON_API_KEY=your-api-key

# Mobile / Expo (mobile/.env):
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side ingest (Edge Function / GitHub Action) — set in Supabase secrets / GitHub secrets
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RSS2JSON_API_KEY=your-api-key
