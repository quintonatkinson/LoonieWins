# Web (Vite) — project oftunznsumfidavvbqz
VITE_SUPABASE_URL=https://oftunznsumfidavvbqz.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional paid rss2json key → fatter client pages (50–100 items vs ~10 free)
# Get at https://rss2json.com/
# VITE_RSS2JSON_API_KEY=your-api-key

# Mobile / Expo (mobile/.env):
# EXPO_PUBLIC_SUPABASE_URL=https://oftunznsumfidavvbqz.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side ingest / push / digest (Supabase Edge secrets — never commit)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RSS2JSON_API_KEY=your-api-key
# EXPO_ACCESS_TOKEN=expo-access-token-for-push-api
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=LoonieWins <digest@your-verified-domain.com>
# DIGEST_APP_URL=https://your-app-origin

# --- Offerwall (AdGem). Without APP_ID / these keys, Earn uses sandbox mock offers. ---
# VITE_OFFERWALL_PROVIDER=adgem
# VITE_ADGEM_APP_ID=your-adgem-app-id
# VITE_ADGEM_API_KEY=your-server-postback-key
# Never put ADGEM_POSTBACK_KEY / service_role in the client — those are Edge Function secrets only.
# VITE_ADGEM_WALL_URL=https://api.adgem.com/v1/wall
# Expo:
# EXPO_PUBLIC_ADGEM_APP_ID=your-adgem-app-id

# --- IAP (RevenueCat public SDK keys only). Without these, QA stub in DEV. ---
# VITE_REVENUECAT_APPLE_API_KEY=appl_xxx
# VITE_REVENUECAT_GOOGLE_API_KEY=goog_xxx
# VITE_REVENUECAT_API_KEY=  # optional shared/test key
# VITE_IAP_ALLOW_STUB=true  # force stub outside DEV (never in production builds)
